{
  "name": "verseangelscript-vscode",
  "displayName": "Verse AngelScript",
  "description": "VAS language editing and explicit compiler/runner tasks for VS Code",
  "version": "0.1.0",
  "publisher": "VerseAngelScript",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aceared0829/VerseAngelScript.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onTaskType:vas"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax editing is available; building and running VAS requires a trusted workspace.",
      "restrictedConfigurations": [
        "vas.compilerPath",
        "vas.runnerPath",
        "vas.configFile",
        "vas.outputDirectory"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The VAS toolchain requires a local or remote filesystem workspace."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "vas",
        "aliases": [
          "Verse AngelScript",
          "VAS"
        ],
        "extensions": [
          ".vas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vas",
        "scopeName": "source.vas",
        "path": "./syntaxes/vas.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vas",
        "path": "./snippets/vas.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "vas.buildCurrentFile",
        "title": "VAS: Build Current File",
        "enablement": "isWorkspaceTrusted && editorLangId == vas"
      },
      {
        "command": "vas.runCurrentFile",
        "title": "VAS: Run Current File",
        "enablement": "isWorkspaceTrusted && editorLangId == vas"
      },
      {
        "command": "vas.buildProject",
        "title": "VAS: Build Project",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vas.buildCurrentFile",
          "when": "editorLangId == vas",
          "group": "vas@1"
        },
        {
          "command": "vas.runCurrentFile",
          "when": "editorLangId == vas",
          "group": "vas@2"
        }
      ]
    },
    "configuration": {
      "title": "Verse AngelScript",
      "properties": {
        "vas.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted vasbuild executable. Configure in User or Remote settings; workspace executables are never auto-discovered."
        },
        "vas.runnerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted vasrun executable. Configure in User or Remote settings."
        },
        "vas.configFile": {
          "type": "string",
          "default": "${workspaceFolder}/.vas/vasbuild.config.txt",
          "scope": "resource",
          "description": "Application interface configuration for vasbuild. Relative paths resolve from the containing workspace folder; ${workspaceFolder} is supported."
        },
        "vas.outputDirectory": {
          "type": "string",
          "default": "${workspaceFolder}/.vas/build",
          "scope": "resource",
          "description": "Bytecode directory inside the workspace. Source subdirectories are preserved to avoid name collisions."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "vas",
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "buildProject"
            ],
            "description": "Build or run a saved source, or build an explicit compiler-owned project unit."
          },
          "file": {
            "type": "string",
            "description": "Entry .vas file relative to this task's workspace folder (or an absolute path inside it). Supports ${workspaceFolder}."
          },
          "project": {
            "type": "string",
            "description": "For buildProject: workspace root vas-project.json (no automatic discovery of nested manifests)."
          },
          "unit": {
            "type": "string",
            "description": "For buildProject: exact case-sensitive compilation unit id from the compiler descriptor."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "vas-errors",
        "owner": "vas",
        "source": "vasbuild",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?)\\s*\\((\\d+),\\s*(\\d+)\\)\\s*:\\s*ERR\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "message": 4
        }
      },
      {
        "name": "vas-warnings",
        "owner": "vas",
        "source": "vasbuild",
        "fileLocation": "absolute",
        "severity": "warning",
        "pattern": {
          "regexp": "^(.+?)\\s*\\((\\d+),\\s*(\\d+)\\)\\s*:\\s*WARN\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/runIntegration.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1"
  }
}
