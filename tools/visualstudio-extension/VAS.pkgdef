// Canonical editor registration. Executable package registration is generated separately. The grammar itself owns only the .vas extension.
[$RootKey$\TextMate\Repositories]
"VerseAngelScript"="$PackageFolder$\Grammars"

[$RootKey$\TextMate\LanguageConfiguration\GrammarMapping]
"source.vas"="$PackageFolder$\language-configuration.json"
