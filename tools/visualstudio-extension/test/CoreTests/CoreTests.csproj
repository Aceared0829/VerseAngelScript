<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net472'" />
    <Compile Include="Program.cs" />
    <Compile Include="FixtureMutationTests.cs" />
    <Compile Include="..\Shared\FixtureMutation.cs" Link="FixtureMutation.cs" />
    <Compile Include="..\..\Build\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\..\Build\NativeProcess.cs" Link="NativeProcess.cs" />
    <Compile Include="..\..\Build\FileIdentity.cs" Link="FileIdentity.cs" />
    <Compile Include="..\..\Build\InputEvents.cs" Link="InputEvents.cs" />
    <Compile Include="..\..\Build\WorkspaceEvents.cs" Link="WorkspaceEvents.cs" />
  </ItemGroup>
</Project>
