<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VerseAngelScript</AssemblyName>
    <RootNamespace>VerseAngelScript.VisualStudio</RootNamespace>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyFromOutputFolderInVSIXContainer>true</IncludeAssemblyFromOutputFolderInVSIXContainer>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
    <IncludeSatelliteAssembliesInVSIXContainer>false</IncludeSatelliteAssembliesInVSIXContainer>
    <DeployExtension>false</DeployExtension>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" Version="17.13.41" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" Version="18.0.42421" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace" Version="17.12.19" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace.VSIntegration" Version="17.12.19" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" />
    <Reference Include="System.Design" /><Reference Include="PresentationCore" /><Reference Include="PresentationFramework" /><Reference Include="WindowsBase" />
    <Reference Include="System.ComponentModel.Composition" />
    <None Update="source.extension.vsixmanifest" />
    <VSCTCompile Include="Commands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <Content Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll" Link="Newtonsoft.Json.dll" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="VAS.pkgdef" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <!-- Canonical assets are linked, never forked. Validate the packaged bytes in CI. -->
    <Content Include="..\vscode-extension\syntaxes\vas.tmLanguage.json" Link="Grammars\vas.tmLanguage.json" VSIXSubPath="Grammars" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\vscode-extension\language-configuration.json" Link="language-configuration.json" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="test\**\*.cs" />
    <EmbeddedResource Remove="test\**\*" />
    <None Remove="test\**\*" />
  </ItemGroup>
</Project>
